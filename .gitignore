# ============================================================================
# PromptsWallet .gitignore
# ============================================================================

# ---- Secrets and credentials (never commit) --------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt
secrets/
credentials*.json
service-account*.json
# Tauri updater / code-signing keys
.tauri/
*.key.pub
tauri.*.key
# Anything that looks like an API key dropped in the tree by accident
*nvapi*
*.token

# ---- Prompt packs and sample content ----------------------------------------
# Test / sample prompts-pack zips (valid, update, invalid) and any pack you build or download
/samples/
promptswallet-pack-*.zip
*.zip
# Raw prompt source text and the scripts that turn it into packs / sample zips
/scripts/source/
/scripts/build_samples.py
# A user's own workspace data (My Prompts, trash, imported packs) if one is ever created in the repo
.promptvault/
/workspace/
/My Prompts/

# ---- Build output ------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
target/
src-tauri/target/
# Generated by Tauri at build time
src-tauri/gen/
# Installers and bundles
*.msi
*.exe
*.dmg
*.app
*.AppImage
*.deb
*.rpm
*.pkg
*.nsis
*.tar.gz
*.tgz
*.tsbuildinfo

# ---- Logs, caches, temp ------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
.cache/
.eslintcache
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~

# ---- Test artefacts ----------------------------------------------------------
playwright-report/
test-results/
screenshots/
shots/
e2e*.js
*.png.tmp

# ---- Editors, OS and AI-assistant files --------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.sublime-*
.DS_Store
.AppleDouble
.Spotlight-V100
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.claude/
.cursor/
.aider*
CLAUDE.md
.mcp.json